# Local (non-Docker) runs read these via godotenv.
# Docker Compose also reads this file for ${VAR} substitution.

# Postgres connection string (used by the Go app for ingest, reports, and the web UI).
DATABASE=postgres://postgres:postgres@127.0.0.1:5432/starcraft2?sslmode=disable

# OpenRouter, required for the serve action (web UI). Any tool-calling model works.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=deepseek/deepseek-chat

# Web server port for the serve action.
PORT=8080

# Tracked players (first is the default -me).
PLAYERS=PlayerA,PlayerB,PlayerC

# Replay directory, required for ingest. Local path for non-Docker runs.
REPLAYS="/path/to/StarCraft II/Accounts/"

# Path to the sidecar binary for non-Docker runs (defaults to ./sc2json next to main).
SC2JSON=./sidecar/target/release/sc2json

# --- Docker Compose only ---

# Superuser password for the postgres container.
POSTGRES_PASSWORD=postgres

# Host replay directory, mounted read-only into the cli container at /replays.
REPLAYS_HOST=/path/to/StarCraft II/Accounts/
